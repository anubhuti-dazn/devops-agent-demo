APP_NAME=devops-agent-demo
APP_ENV=development
DATABASE_URL=sqlite:///./tasks.db
SECRET_KEY=change-me-in-production
MAX_TASKS_PER_USER=100

# AWS (required for CloudWatch logging + DevOps Agent)
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# CloudWatch log groups (used by the Lambda trigger)
CW_LOG_GROUP=/devops-agent-demo

# AWS DevOps Agent — set your Agent Space ID here
# Find it in the AWS Console under AI DevOps Agent > Agent Spaces
AGENT_SPACE_ID=

# Coralogix (optional — Lambda falls back to CloudWatch Logs if not set)
CORALOGIX_ENDPOINT=https://api.eu2.coralogix.com/data/os-api/*/_search
CORALOGIX_API_KEY=

# GitHub PAT — used by the Lambda to open issues with the agent diagnosis
# Required scopes: repo (issues:write)
GITHUB_TOKEN=
