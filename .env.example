APP_NAME=devops-agent-demo
APP_ENV=development
DATABASE_URL=sqlite:///./tasks.db
SECRET_KEY=change-me-in-production
MAX_TASKS_PER_USER=100

# AWS / CloudWatch (leave blank to disable CloudWatch and log to console only)
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CW_LOG_GROUP=/devops-agent-demo
